        - 111
      ConvertAndToDict:
        _target_: watchmal.dataset.graph.pyg_transformations.ConvertAndToDict
        feature_to_type: float32
        target_to_type: int64
tasks:
  train:
    epochs: 44
    val_interval: 20
    checkpointing: false
    data_loaders:
      train:
        split_key: train_idxs
        is_graph: true
        drop_last: true
        persistent_workers: false
        pin_memory: false
        seed: 4
        num_workers: 8
        batch_size: 1000
        sampler_config:
          _target_: watchmal.dataset.samplers.samplers.SubsetRandomSampler
      validation:
        split_key: val_idxs
        is_graph: true
        drop_last: true
        persistent_workers: false
        pin_memory: false
        num_workers: 8
        batch_size: 1000
        sampler_config:
          _target_: watchmal.dataset.samplers.samplers.SubsetRandomSampler
    loss:
      _target_: torch.nn.CrossEntropyLoss
      weight: null
    optimizers:
      _target_: torch.optim.AdamW
      lr: 0.002
      weight_decay: 0.001
    scheduler:
      _target_: torch.optim.lr_scheduler.OneCycleLR
      max_lr: 0.0005
      total_steps: 310000
      pct_start: 0.01
      anneal_strategy: cos
      div_factor: 50
      final_div_factor: 500
  restore_best_state:
    name: null
  evaluate:
    prefix_for_plot_names: debug_trained_
    report_interval: 30
    batch_log: true
    data_loaders:
      test:
        split_key: test_idxs
        is_graph: true
        drop_last: true
        pin_memory: false
        seed: null
        num_workers: 5
        batch_size: 1000
        sampler_config:
          _target_: watchmal.dataset.samplers.samplers.SubsetSequentialSampler
