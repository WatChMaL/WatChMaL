  target_key: target
  flatten_model_output: false
  prediction_threshold: null
data:
  dataset:
    split_path: /user/nfost94/HKSim/Current_Analysis/Watchmal/5mil_indices_class.npz
    fully_processed: false
    compute_edges_parameters: null
    target_names:
    - e-
    - mu-
    - gamma
    - pi0
    signal_key: e-
    dataset_parameters:
      _target_: watchmal.dataset.graph.h5_graph.H5GraphDataset
      time_order: false
      graph_folder_path: /data/nfost94/hdf5/
      graph_file_names:
      - 5mil_classification.h5
      verbose: 1
  transforms:
    transforms:
      SliceY:
        _target_: watchmal.dataset.graph.pyg_transformations.SliceY
        slice_indices:
        - 0
      AddPMTPositions:
        _target_: watchmal.dataset.graph.pyg_transformations.AddPMTPositions
        geometry_npz_path: /user/nfost94/HKSim/Current_Analysis/Watchmal/hk_geometry/geometry.npz
      DarkNoiseAugmentation:
        _target_: watchmal.dataset.graph.pyg_transformations.DarkNoiseAugmentation
        geometry_npz_path: /user/nfost94/HKSim/Current_Analysis/Watchmal/hk_geometry/geometry.npz
        dark_rate_range_khz:
        - 0
        - 10.0
        t_low: 550.0
        t_high: 1900.0
        deadtime_ns: 560.0
        timing_precision_ns: 0.1
        pe_precision_pe: 0.3
        charge_col: 1
        time_col: 0
        conv_rate: 1.1125
      RandomCylindricalTransform:
        _target_: watchmal.dataset.graph.pyg_transformations.RandomCylindricalTransform
      Normalize:
        _target_: watchmal.dataset.graph.pyg_transformations.Normalize
        apply_log:
        - false
        - true
        - false
        - false
        - false
        eps: 1.0e-12
        feat_norm:
        - - 1900
          - 1000
          - 3300
          - 3300
          - 3300
        - - 550
          - 0.0
          - -3300
          - -3300
          - -3300
      CenterTimeByEvent:
        _target_: watchmal.dataset.graph.pyg_transformations.CenterTimeByEvent
        time_col: 0
      MapLabels:
        _target_: watchmal.dataset.graph.pyg_transformations.MapLabels
        label_set:
        - 11
        - 13
        - 22
        - 111
      ConvertAndToDict:
        _target_: watchmal.dataset.graph.pyg_transformations.ConvertAndToDict
        feature_to_type: float32
        target_to_type: int64
tasks:
  train:
    epochs: 44
    val_interval: 20
    checkpointing: false
    data_loaders:
      train:
        split_key: train_idxs
        is_graph: true
        drop_last: true
        persistent_workers: false
        pin_memory: false
        seed: 4
        num_workers: 8
        batch_size: 1000
        sampler_config:
          _target_: watchmal.dataset.samplers.samplers.SubsetRandomSampler
      validation:
        split_key: val_idxs
        is_graph: true
        drop_last: true
        persistent_workers: false
        pin_memory: false
        num_workers: 8
        batch_size: 1000
        sampler_config:
          _target_: watchmal.dataset.samplers.samplers.SubsetRandomSampler
    loss:
      _target_: torch.nn.CrossEntropyLoss
      weight: null
    optimizers:
      _target_: torch.optim.AdamW
      lr: 0.002
      weight_decay: 0.001
    scheduler:
      _target_: torch.optim.lr_scheduler.OneCycleLR
      max_lr: 0.0005
      total_steps: 310000
      pct_start: 0.01
      anneal_strategy: cos
      div_factor: 50
      final_div_factor: 500
  restore_best_state:
    name: null
  evaluate:
    prefix_for_plot_names: debug_trained_
    report_interval: 30
    batch_log: true
    data_loaders:
      test:
        split_key: test_idxs
        is_graph: true
        drop_last: true
        pin_memory: false
        seed: null
        num_workers: 5
        batch_size: 1000
        sampler_config:
          _target_: watchmal.dataset.samplers.samplers.SubsetSequentialSampler
MASTER_PORT: 12357
find_unused_parameters: true
seed: 1234
deterministic: false
gpu_list:
- 5
launch_wandb: true

