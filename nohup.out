      - 5mil_classification.h5
      verbose: 1
  transforms:
    transforms:
      SliceY:
        _target_: watchmal.dataset.graph.pyg_transformations.SliceY
        slice_indices:
        - 0
      AddPMTPositions:
        _target_: watchmal.dataset.graph.pyg_transformations.AddPMTPositions
        geometry_npz_path: /user/nfost94/HKSim/Current_Analysis/Watchmal/hk_geometry/geometry.npz
      DarkNoiseAugmentation:
        _target_: watchmal.dataset.graph.pyg_transformations.DarkNoiseAugmentation
        geometry_npz_path: /user/nfost94/HKSim/Current_Analysis/Watchmal/hk_geometry/geometry.npz
        dark_rate_range_khz:
        - 0
        - 10.0
        t_low: 550.0
        t_high: 1900.0
        deadtime_ns: 560.0
        timing_precision_ns: 0.1
        pe_precision_pe: 0.3
        charge_col: 1
        time_col: 0
        conv_rate: 1.1125
      RandomCylindricalTransform:
        _target_: watchmal.dataset.graph.pyg_transformations.RandomCylindricalTransform
      Normalize:
        _target_: watchmal.dataset.graph.pyg_transformations.Normalize
        apply_log:
        - false
        - true
        - false
        - false
        - false
        eps: 1.0e-12
        feat_norm:
        - - 1900
          - 1000
          - 3300
          - 3300
